<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= it.filename %></title>
  <meta property="og:title" content="<%= it.filename %>" />
  <meta property="og:url" content="<%= it.embedUrl %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <% if (it.kind === "image") { %>
    <meta property="og:type" content="website" />
    <meta property="og:image" content="<%= it.embedUrl %>" />
    <meta name="twitter:image" content="<%= it.embedUrl %>" />
  <% } else if (it.kind === "video") { %>
    <meta property="og:type" content="video.other" />
    <meta property="og:video" content="<%= it.embedUrl %>" />
    <meta property="og:video:type" content="<%= it.mimetype %>" />
  <% } else if (it.kind === "audio") { %>
    <meta property="og:type" content="music.song" />
    <meta property="og:audio" content="<%= it.embedUrl %>" />
    <meta property="og:audio:type" content="<%= it.mimetype %>" />
  <% } %>
  <link rel="icon" type="image/webp" href="/public/img/favicon.webp" />
  <link rel="stylesheet" href="/public/css/new.css" />
  <style>
    body.file-viewer { min-height: 100vh; display: flex; flex-direction: column; opacity: 1 !important; }
    .file-viewer-header { display: flex; align-items: center; justify-content: flex-end; gap: 16px; padding: 16px 24px; }
    .service-announcement { width: min(100% - 32px, 1200px); box-sizing: border-box; display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin: 16px auto 0; padding: 12px 16px; border-radius: 8px; border: 1px solid rgba(255,255,255,.2); }
    .service-announcement-info { background: rgba(80, 150, 255, .18); }
    .service-announcement-warning { background: rgba(255, 180, 50, .2); }
    .service-announcement-critical { background: rgba(240, 70, 70, .22); }
    .service-announcement > span { flex: 1 1 240px; min-width: 0; overflow-wrap: anywhere; }
    .service-announcement .input-button { float: none; flex: 0 0 auto; }
    .file-viewer-content { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 0; padding: 24px; }
    .file-viewer-content > .input-button { margin-top: 16px; }
    .image-lightbox { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; background: rgba(0,0,0,.88); overflow: hidden; }
    .image-lightbox.is-open { display: flex; }
    .image-lightbox-image { max-width: 90vw; max-height: 90vh; user-select: none; -webkit-user-drag: none; touch-action: none; cursor: grab; transform-origin: center center; }
    .image-lightbox-image.is-dragging { cursor: grabbing; }
    .image-lightbox-controls { position: fixed; top: 16px; right: 16px; z-index: 1; display: flex; gap: 8px; }
    .image-lightbox-hint { position: fixed; bottom: 16px; left: 16px; opacity: .7; }
    .file-viewer-media { display: block; flex: 0 1 auto; min-width: 0; min-height: 0; width: auto; height: auto; max-width: calc(100vw - 48px); max-height: calc(100vh - 180px); object-fit: contain; border-radius: 8px; }
    .file-viewer-content > img { cursor: zoom-in; }
    video.file-viewer-media, audio.file-viewer-media { width: min(100%, 1000px); }
    .file-viewer-frame { width: min(100%, 1200px); height: 75vh; border: 0; background: white; }
    .file-viewer-download { margin-top: 16px; }
    .file-viewer-footer { padding: 16px 24px; text-align: center; }
    @media (max-width: 600px) { .file-viewer-header { padding: 12px 16px; } .file-viewer-content { padding: 16px; } }
  </style>
</head>
<body class="file-viewer">
  <header class="file-viewer-header"></header>
  <% if (it.announcement) { %>
    <aside class="service-announcement service-announcement-<%= it.announcement.severity %>">
      <span><%~ it.announcement.message %></span>
      <% if (it.announcement.button_text && it.announcement.button_url) { %>
        <a class="input-button" href="<%= it.announcement.button_url %>" target="_blank" rel="noopener noreferrer"><%= it.announcement.button_text %></a>
      <% } %>
    </aside>
  <% } %>
  <main class="file-viewer-content" id="file-viewer-content">
    <% if (it.kind === "image") { %>
      <img class="file-viewer-media" src="<%= it.rawUrl %>" alt="<%= it.filename %>" />
    <% } else if (it.kind === "video") { %>
      <video class="file-viewer-media" src="<%= it.rawUrl %>" controls playsinline></video>
    <% } else if (it.kind === "audio") { %>
      <audio class="file-viewer-media" src="<%= it.rawUrl %>" controls></audio>
    <% } else if (it.kind === "pdf") { %>
      <iframe class="file-viewer-frame" src="<%= it.rawUrl %>" title="<%= it.filename %>"></iframe>
    <% } else { %>
      <section class="dashboard-block">
        <h1><%= it.filename %></h1>
        <p>This file cannot be previewed in the browser.</p>
        <a class="input-button file-viewer-download" href="<%= it.downloadUrl %>">Download file</a>
      </section>
    <% } %>
    <% if (it.kind !== "other") { %>
      <a class="input-button" id="file-viewer-download" href="<%= it.downloadUrl %>">Download</a>
    <% } %>
  </main>
  <footer class="file-viewer-footer small-text">
    <%= it.filename %>
  </footer>
  <% if (it.kind === "image") { %>
    <div class="image-lightbox" id="image-lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
      <div class="image-lightbox-controls">
        <button class="input-button" id="image-zoom-out" type="button">−</button>
        <button class="input-button" id="image-zoom-reset" type="button">Reset</button>
        <button class="input-button" id="image-zoom-in" type="button">+</button>
        <button class="input-button" id="image-lightbox-close" type="button">Close</button>
      </div>
      <img class="image-lightbox-image" id="image-lightbox-image" draggable="false" src="<%= it.rawUrl %>" alt="<%= it.filename %>" />
      <span class="image-lightbox-hint small-text">Scroll to zoom · drag to move · double-click to zoom</span>
    </div>
  <% } %>
<script>
  (() => {
    const preview = document.querySelector('.file-viewer-content > img');
    const lightbox = document.querySelector('#image-lightbox');
    const lightboxImage = document.querySelector('#image-lightbox-image');
    if (preview && lightbox && lightboxImage) {
      let scale = 1;
      let offsetX = 0;
      let offsetY = 0;
      let dragging = false;
      let startX = 0;
      let startY = 0;

      const renderImage = () => {
        lightboxImage.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
      };
      const setScale = (value) => {
        scale = Math.min(8, Math.max(1, value));
        if (scale === 1) { offsetX = 0; offsetY = 0; }
        renderImage();
      };
      const openLightbox = () => {
        lightbox.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        setScale(1);
      };
      const closeLightbox = () => {
        lightbox.classList.remove('is-open');
        document.body.style.overflow = '';
      };

      preview.addEventListener('click', openLightbox);
      document.querySelector('#image-lightbox-close').addEventListener('click', closeLightbox);
      document.querySelector('#image-zoom-in').addEventListener('click', () => setScale(scale + .5));
      document.querySelector('#image-zoom-out').addEventListener('click', () => setScale(scale - .5));
      document.querySelector('#image-zoom-reset').addEventListener('click', () => setScale(1));
      lightbox.addEventListener('click', (event) => { if (event.target === lightbox) closeLightbox(); });
      document.addEventListener('keydown', (event) => {
        if (!lightbox.classList.contains('is-open')) return;
        if (event.key === 'Escape') closeLightbox();
        if (event.key === '+') setScale(scale + .5);
        if (event.key === '-') setScale(scale - .5);
      });
      lightboxImage.addEventListener('wheel', (event) => {
        event.preventDefault();
        setScale(scale + (event.deltaY < 0 ? .25 : -.25));
      }, { passive: false });
      lightboxImage.addEventListener('dblclick', () => setScale(scale === 1 ? 2 : 1));
      lightboxImage.addEventListener('dragstart', (event) => event.preventDefault());
      lightboxImage.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        dragging = true;
        startX = event.clientX - offsetX;
        startY = event.clientY - offsetY;
        lightboxImage.classList.add('is-dragging');
        lightboxImage.setPointerCapture(event.pointerId);
      });
      lightboxImage.addEventListener('pointermove', (event) => {
        if (!dragging || scale === 1) return;
        event.preventDefault();
        offsetX = event.clientX - startX;
        offsetY = event.clientY - startY;
        renderImage();
      });
      const stopDragging = () => {
        dragging = false;
        lightboxImage.classList.remove('is-dragging');
      };
      lightboxImage.addEventListener('pointerup', stopDragging);
      lightboxImage.addEventListener('pointercancel', stopDragging);
      lightboxImage.addEventListener('lostpointercapture', stopDragging);
    }

    const header = document.querySelector('.file-viewer-header');
    const content = document.querySelector('#file-viewer-content');
    const button = document.querySelector('#file-viewer-download');
    const media = document.querySelector('.file-viewer-media, .file-viewer-frame');
    if (!button || !media) return;

    const placeDownloadButton = () => {
      if (media.getBoundingClientRect().bottom + button.offsetHeight + 24 <= window.innerHeight)
        content.appendChild(button);
      else
        header.appendChild(button);
    };
    media.addEventListener('load', placeDownloadButton);
    media.addEventListener('loadedmetadata', placeDownloadButton);
    placeDownloadButton();
    window.addEventListener('resize', placeDownloadButton);
  })();
</script>
</body>
</html>
