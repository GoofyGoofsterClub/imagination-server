<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Cute Image Uploader</title>
  <link rel="icon" type="image/webp" href="/public/img/favicon.webp" />
  <meta name="og:title" content="Cute Image Uploader" />
  <meta
    name="og:description"
    content="The only way I know how to upload files now"
  />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@mishashto" />
  <meta name="twitter:title" content="Cute Image Uploader" />
  <meta
    name="twitter:description"
    content="The only way I know how to upload files now"
  />
  <link rel="stylesheet" href="/public/css/new.css" />
  <script>window.__APP = <%~ it.bootstrap %>;
    if (location.hash && location.hash !== '#welcome') document.documentElement.classList.add('inner-page');
  </script>
  <style>.inner-page .big-showoff { display: none; }</style>
  <script defer src="/public/js/request.js"></script>
  <script defer src="/public/js/tooltips.js"></script>
  <script defer src="/public/js/translatable.js"></script>
  <script defer src="/public/js/new.js"></script>
</head>
<body>
  <div class="big-showoff">
    <div class="flex">
      <div class="content" style="direction: initial">
        <span
          class="small-header-domain stagger-header"
          ><%= it.domain %></span
        >
        <span
          class="big-header stagger-header"
          translatable-id="main-header"
          >Cute Image Uploader</span
        >
        <span
          class="small-header stagger-header"
          translatable-id="main-header-sub"
          >The only way I know how to upload files now</span
        >
      </div>
    </div>
    <img
      data-src="/public/img/sagiri.png"
      data-srcset="/public/img/sagiri-450.webp 450w, /public/img/sagiri.png 903w"
      width="903" height="1790" alt="" decoding="async" fetchpriority="high"
      class="anime-girl"
    />
  </div>
  <div class="navbar">
    <div class="content">
      <a
        class="nav-el"
        href="#welcome"
        data-content="welcome"
        data-umami-event="Welcome button press"
        ><span translatable-id="navbar-welcome">Welcome</span></a
      >
       <a class="nav-el" href="#faq" data-content="faq" data-umami-event="FAQ button press"
        ><span translatable-id="navbar-faq">FAQ</span></a
      >
      <a
        class="nav-el"
        href="#dashboard"
        data-content="dashboard"
        data-umami-event="Dashboard button press"
        ><span translatable-id="navbar-dashboard">Dashboard</span></a
      >
       <a class="nav-el bland language-selector"
        ><span
          >&nbsp;<select
            class="input-button"
            id="__main_language_select"
          ></select></span
      ></a>
    </div>
  </div>
  <noscript>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/please/enable.js" />
    </noscript>
  </noscript>
  <div class="content" id="page-content" aria-live="polite">
    <h1 translatable-id="welcome-header">Welcome!</h1>
    <p><span translatable-id="welcome-uploads-before">So far, our community has shared</span>
      <b id="__upload_counter">…</b> <span translatable-id="welcome-uploads-after">files and received</span>
      <b id="__views_counter">…</b> <span translatable-id="welcome-views-after">views.</span></p>
  </div>
  <div class="legal">
    <a href="https://reze.moe/" class="me" data-umami-event="reze.moe button press">reze.moe</a>
    <a href="#" onclick="ChangePage('contribution'); return false;" class="me" data-umami-event="Contributors button press"
      >contributors</a
    >
    <a href="https://mishashto.com/terms" class="me" data-umami-event="TOS button press"
      >tos</a
    >
    <a href="https://github.com/GoofyGoofsterClub/imagination-server" class="me" data-umami-event="Source button press"
      >source</a
    >
    ♥
  </div>
</body>
