# Opt-in example. Mount privateuploads read-only at /srv/imagination/uploads.
# In the app set MEDIA_ACCEL_PREFIX=/_uploads/ and TRUST_PROXY to this proxy's
# exact address/CIDR. Do not expose the application port to untrusted networks.
upstream imagination {
    server 127.0.0.1:3443;
    keepalive 32;
}

server {
    listen 8080;
    # Match MAX_UPLOAD_SIZE, with room for multipart framing.
    client_max_body_size 11g;
    sendfile on;
    tcp_nopush on;

    location /_uploads/ {
        internal;
        alias /srv/imagination/uploads/;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://imagination;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 130s;
        # Never shared-cache mixed HTML/file routes or authenticated APIs.
        proxy_cache off;
    }
}
